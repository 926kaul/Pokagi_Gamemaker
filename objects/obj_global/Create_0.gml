// 저장
for (var i = 1; i <= 151; i++) {
    global.poke_stats[i] = {
		type1:		 types[i-1][0],
		type2:		 (array_length(types[i-1]) == 2) ? types[i-1][1] : 0,
        size:        data[i-1][0],
        mass_move:   data[i-1][1],
        mass_stop:   data[i-1][2],
        max_speed:   data[i-1][3]
    };
}

