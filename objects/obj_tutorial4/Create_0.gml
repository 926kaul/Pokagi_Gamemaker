text_string = "4. 모든 포켓몬은 한 '세대'에 움직일 수 있는 한 턴씩을 가집니다. 한 세대 내에서 턴 순서는 세대가 시작할 때 중심에서 먼 순서대로 결정됩니다. 이번 세대의 턴 순서는 왼쪽 위의 작은 아이콘으로 확인할 수 있습니다.";
text_string_dex_end = "포까기 모험은 여기까지입니다. 뮤를 잡고 마지막을 장식해주세요.\n지금까지 플레이 해주셔서 진심으로 감사드립니다."
text_color = c_black;
text_font = Font5;
text_halign = fa_left;
text_valign = fa_top;

bg_color = make_colour_rgb(255, 255, 128); // 밝은 연노랑 (포스트잇 색)
bg_padding = 8; // 텍스트와 배경 사각형 사이의 여백 (픽셀)